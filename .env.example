# ==============================================================================
# UNIVERSITY ACADEMIC MANAGEMENT SYSTEM (UAMS) - ENVIRONMENT TEMPLATE
# AL-MUSTANSIRIYAH UNIVERSITY | BACKEND ENVIRONMENT TEMPLATE
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to '.env' and fill in your actual production/staging values:
#   cp .env.example .env
# ==============================================================================

# 1. CORE SERVER & RUNTIME ENVIRONMENT
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# 2. UNIVERSITY DOMAIN & ACADEMIC CONSTRAINTS
UNIVERSITY_NAME="Al-Mustansiriyah University"
UNIVERSITY_EMAIL_DOMAIN=uomustansiriyah.edu.iq

# 3. MONGODB DATABASE CONFIGURATION
# Local: mongodb://127.0.0.1:27017/uams_db
# Cloud: mongodb+srv://<USERNAME>:<PASSWORD>@cluster.mongodb.net/uams_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/uams_db
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=10
MONGO_TIMEOUT_MS=5000

# 4. DUAL-TOKEN AUTHENTICATION & CRYPTOGRAPHY (JWT + RTR)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_here
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_SECRET=replace_with_a_different_secure_64_character_hex_secret
JWT_REFRESH_EXPIRE_DAYS=7
QR_TOKEN_SECRET=replace_with_a_secure_qr_session_salt_key
DIGITAL_ID_SECRET=replace_with_a_secure_digital_id_salt_key
BCRYPT_SALT_ROUNDS=12

# 5. COOKIE & CSRF POLICY
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
# COOKIE_DOMAIN=.uomustansiriyah.edu.iq

# 6. CORS (CROSS-ORIGIN RESOURCE SHARING) WHITELIST
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 7. SECURITY RATE LIMITING & ACCOUNT LOCKOUT
RATE_LIMIT_GLOBAL_MAX=300
AUTH_RATE_LIMIT_MAX=10
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# 8. FILE STORAGE & COURSE MATERIALS
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_BYTES=0
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.presentationml.presentation

# 9. CAMPUS GEOFENCING & ATTENDANCE DEFAULTS
CAMPUS_DEFAULT_LATITUDE=33.3152
CAMPUS_DEFAULT_LONGITUDE=44.3661
DEFAULT_GEOFENCE_RADIUS_METERS=150

# 10. SMTP EMAIL SERVICE (PASSWORD RESETS & ACADEMIC NOTICES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=uams.support@uomustansiriyah.edu.iq
SMTP_PASSWORD=your_university_app_password_here
EMAIL_FROM_NAME="Mustansiriyah UAMS Portal"
EMAIL_FROM_ADDRESS=noreply@uomustansiriyah.edu.iq

# 11. DEVELOPER CONSOLE & LOGGING PREFERENCES
DEV_CONSOLE_REALTIME=true
DEV_ERROR_DECOMPILER=true
